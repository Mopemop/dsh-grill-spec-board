{
  "name": "dsh-specboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SpecBoard: 规格驱动开发面板与 grill/TDD 门禁（DSH Web UI 插件）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mopemop/dsh-grill-spec-board.git"
  },
  "homepage": "https://github.com/Mopemop/dsh-grill-spec-board",
  "keywords": ["dsh", "dsh-plugin", "spec-driven", "openspec", "grill", "tdd"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
